# The same superproject after it has been wired up: two committed submodules
# (one checked out, one deinitialised), and three linked worktrees (one
# healthy, one locked, one whose directory has been deleted so `prune` has
# something to find). Every command under test therefore meets pre-existing
# multi-repo state rather than having to create it first, which keeps the
# cases free of the path nondeterminism that creating one would introduce.
#
# Everything is built with real git, so both sides of the harness start from
# byte-identical state. The submodule URLs in .gitmodules are RELATIVE on
# purpose: an absolute URL would differ between the two fixture roots and so
# would change the committed tree -- and with it every hash the cases print.
c () { # $1 = message, $2 = seconds past the base date
  GIT_AUTHOR_DATE="$((1700000000 + $2)) +0000" \
  GIT_COMMITTER_DATE="$((1700000000 + $2)) +0000" \
  git commit -qm "$1"
}
git config --global protocol.file.allow always

printf '/.ext/\n/wt/\n' > .gitignore
printf 'a\n' > a.txt
git add -A && c "c1 add files" 10
git checkout -q -b side
printf 'side\n' > s.txt
git add -A && c "c2 side adds s" 20
git checkout -q main

# Donor repositories, ignored so they are not worktree noise. See
# multirepo.fixture for why they live inside the repository.
mkdir -p .ext/lib
( cd .ext/lib && git init -q -b main . \
  && git config user.email t@e && git config user.name T \
  && printf 'l1\n' > l.txt && git add -A \
  && GIT_AUTHOR_DATE='1700000100 +0000' GIT_COMMITTER_DATE='1700000100 +0000' \
     git commit -qm "lib c1" \
  && printf 'l2\n' >> l.txt && git add -A \
  && GIT_AUTHOR_DATE='1700000110 +0000' GIT_COMMITTER_DATE='1700000110 +0000' \
     git commit -qm "lib c2" )
mkdir -p .ext/lib2
( cd .ext/lib2 && git init -q -b main . \
  && git config user.email t@e && git config user.name T \
  && printf 'm1\n' > m.txt && git add -A \
  && GIT_AUTHOR_DATE='1700000130 +0000' GIT_COMMITTER_DATE='1700000130 +0000' \
     git commit -qm "lib2 c1" )

# Submodule `lib` stays checked out; submodule `opt` is registered in the
# tree but its working directory is emptied and its config entry dropped, so
# it is exactly the "not initialised" state that `status`/`init`/`update`
# have to distinguish.
git -c protocol.file.allow=always submodule add -q ./.ext/lib lib
git -c protocol.file.allow=always submodule add -q ./.ext/lib2 opt
git add -A && c "c3 add submodules" 30
git submodule deinit -q --force opt

# `lib` is left one commit BEHIND its recorded gitlink is not what we want --
# instead move its checkout one commit back, so `status` must report the
# "+<sha>" (checked-out commit differs from the index) case.
git -C lib checkout -q HEAD~1

# Three linked worktrees. They live inside the superproject so that the
# absolute paths `worktree list` prints fall under the fixture root and are
# canonicalised by the harness; an external path would leak the two distinct
# temporary directories into stdout.
git worktree add -q wt/live side
git worktree add -q --detach wt/lockd HEAD
git worktree lock wt/lockd
git worktree add -q --detach wt/gone HEAD
rm -rf wt/gone

git config core.editor true

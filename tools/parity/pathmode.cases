# A path limit must keep a commit that only changed the file's mode.
log --oneline -- a.txt
log -- a.txt
log -p -- a.txt
log --stat -- a.txt
log --name-status -- a.txt
log --raw -- a.txt

# A directory limit over the unrelated file.
log --oneline -- sub
log -p -- sub/b.txt

# Both paths together, and the graph over a path limit.
log --oneline -- a.txt sub/b.txt
log --graph --oneline -- a.txt

# --raw / --name-status detect the rename (R100) by default, like git.
log --raw
log --name-status
log --raw -- sub/renamed.txt

# --follow tracks the file across the rename (linear history): it shows the
# earlier commits under the old name and renders each diff limited to the
# file's name(s) then, so the rename shows as R.
log --follow --oneline sub/renamed.txt
log --follow sub/renamed.txt
log --follow --name-status sub/renamed.txt
log --follow --stat sub/renamed.txt
log --follow -p sub/renamed.txt
log --follow --raw sub/renamed.txt
log --follow --oneline -2 sub/renamed.txt

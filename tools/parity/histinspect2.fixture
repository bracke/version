# Two branches that diverged from a common base, which is the shape the
# range/patch commands are actually about: merge-base has a non-trivial
# answer, format-patch has a series to emit, and range-diff has two versions
# of the "same" series to line up against each other.
#
# `topic` and `rebased` are the same three logical changes, but `rebased`
# sits on a later base and has one commit whose content was amended, so a
# correct range-diff must report one unchanged pair, one changed pair and
# the offset. `orphan` shares no history at all, so merge-base has an empty
# answer to give.
c () { # $1 = message, $2 = seconds past the base date, $3 = author name
  GIT_AUTHOR_DATE="$((1700000000 + $2)) +0000" \
  GIT_COMMITTER_DATE="$((1700000000 + $2)) +0000" \
  GIT_AUTHOR_NAME="${3:-T}" GIT_AUTHOR_EMAIL="$(echo "${3:-T}" | tr 'A-Z ' 'a-z_')@e" \
  git commit -qm "$1"
}
printf 'base\n' > base.txt
git add -A && c "b1 base" 10 "Alice"
printf 'base2\n' >> base.txt
git add -A && c "b2 base grows" 20 "Alice"
git tag base

git checkout -q -b topic
printf 'one\n' > f1.txt
git add -A && c "t1 add f1" 30 "Bob"
printf 'two\n' > f2.txt
git add -A && c "t2 add f2" 40 "Bob"
printf 'three\n' >> f1.txt
git add -A && c "t3 extend f1" 50 "Carol"

git checkout -q main
printf 'base3\n' >> base.txt
git add -A && c "b3 base moves on" 60 "Alice"

git checkout -q -b rebased main
printf 'one\n' > f1.txt
git add -A && c "t1 add f1" 70 "Bob"
printf 'two\n' > f2.txt
git add -A && c "t2 add f2" 80 "Bob"
printf 'THREE\n' >> f1.txt
git add -A && c "t3 extend f1" 90 "Carol"

git checkout -q --orphan orphan
git rm -qrf . >/dev/null 2>&1
printf 'lonely\n' > o.txt
git add -A && c "o1 unrelated root" 100 "Dave"

git checkout -q main

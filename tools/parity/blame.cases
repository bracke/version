# Default blames the working tree, so edited lines are not committed yet.
blame f.txt
# A named revision blames that revision's copy instead.
blame HEAD f.txt
blame HEAD~1 f.txt
# An unmodified file reads the same either way.
blame g.txt
blame HEAD g.txt
# In the index but in no commit: every line is simply uncommitted.
blame s.txt
# Untracked, or absent entirely: a die(), not a file of uncommitted lines.
blame u.txt
blame nosuch.txt

# Annotation-shaping options: -s drops author/date, -l/--abbrev set the id
# width, -e shows the email, -t the raw time, -f the filename, -L a line range.
blame -s f.txt
blame -l f.txt
blame -e f.txt
blame -t f.txt
blame -f f.txt
blame --abbrev=10 f.txt
blame -L 2,3 f.txt
blame -L 2 f.txt
blame -L 1,+2 f.txt
blame -s -l f.txt
blame -f -e f.txt
blame -l -f HEAD f.txt
blame -e -t HEAD~1 f.txt
blame HEAD~1 -- f.txt
blame -s g.txt
# -n adds the original line number; --porcelain/--line-porcelain are the
# machine formats (per-commit block, group counts, boundary/previous).
blame -n f.txt
blame -s -n f.txt
blame -f -n f.txt
blame -n -l f.txt
# Blamed at a committed revision so the porcelain timestamps are deterministic
# (the working-tree form times uncommitted lines at "now").
blame --porcelain HEAD f.txt
blame --line-porcelain HEAD f.txt
blame --porcelain HEAD~1 f.txt
blame --porcelain g.txt
# -w ignores whitespace, so the reindented line is credited to its original
# commit rather than the reindent.
blame -w HEAD f.txt
blame -w -s HEAD f.txt
blame -w -n HEAD f.txt
blame -w --porcelain HEAD f.txt

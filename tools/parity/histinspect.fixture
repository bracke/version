# A history for the inspection commands: several distinct authors so shortlog
# has something to group and sort, a merge so --no-merges/--merges and the
# merge-commit rendering of `show` are exercised, tags so name resolution is
# involved, and a handful of checkouts so the HEAD reflog has more than one
# kind of entry in it.
#
# Every commit gets its own increasing timestamp. The harness pins one date
# for all commits, which would turn any date-ordered or date-formatted output
# into a tie-break artifact rather than a behaviour worth matching.
c () { # $1 = message, $2 = seconds past the base date, $3 = author name
  GIT_AUTHOR_DATE="$((1700000000 + $2)) +0000" \
  GIT_COMMITTER_DATE="$((1700000000 + $2)) +0000" \
  GIT_AUTHOR_NAME="${3:-T}" GIT_AUTHOR_EMAIL="$(echo "${3:-T}" | tr 'A-Z ' 'a-z_')@e" \
  git commit -qm "$1"
}
printf 'a\n' > a.txt
git add -A && c "c1 add a" 10 "Alice"
printf 'b\n' > b.txt
mkdir -p sub && printf 'n\n' > sub/n.txt
git add -A && c "c2 add b and sub" 20 "Bob"
git tag v1
git checkout -q -b side
printf 'side\n' > s.txt
git add -A && c "c3 side adds s" 30 "Alice"
printf 'more\n' >> s.txt
git add -A && c "c4 side edits s" 40 "Carol"
git checkout -q main
printf 'a2\n' >> a.txt
git add -A && c "c5 main edits a" 50 "Alice"
GIT_AUTHOR_DATE="1700000060 +0000" GIT_COMMITTER_DATE="1700000060 +0000" \
  GIT_AUTHOR_NAME="Bob" GIT_AUTHOR_EMAIL="bob@e" \
  git merge -q --no-ff -m "c6 merge side" side
printf 'a3\n' >> a.txt
git rm -q --cached sub/n.txt && rm -f sub/n.txt
git add -A && c "c7 main edits a, drops sub" 70 "Carol"
git tag -a v2 -m "release two"

# git says nothing at all for these.
restore a.txt
restore --staged a.txt
restore --source=HEAD a.txt
checkout HEAD -- a.txt
archive --format=tar HEAD -o out.tar
# A switch is reported on stderr, so stdout must stay empty.
checkout other
checkout main
switch other
checkout HEAD~1
switch --detach HEAD
# stash speaks on stdout, and names the commit it was taken against.
stash push
stash list
# -m/--message (and the legacy `save`) title the stash "On <branch>: <msg>"
# instead of the default "WIP on <branch>: <short> <subject>".
stash push -m gatemsg
stash push --message two-words
stash save savemsg
stash save -m savemmsg
stash save -u utrmsg
# stash show defaults to a diffstat and shows only tracked changes (the
# untracked u.txt is omitted); the diff-format flags select other renderings.
stash show
stash show -p
stash show --patch
stash show --stat
stash show --name-only
stash show --name-status
stash show --numstat
stash show --shortstat
stash show stash@{0}
stash show --stat stash@{0}
# clear prints nothing.
stash clear
# A local change the target commit would write over must still be refused.
checkout HEAD~1
switch --detach HEAD~1
